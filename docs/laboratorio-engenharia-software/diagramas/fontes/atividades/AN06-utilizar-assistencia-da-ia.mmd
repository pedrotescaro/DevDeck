flowchart TD
    subgraph usuario ["Usuário"]
        informar["Informar dúvida"]
        revisar["Revisar orientação"]
        decidir["Decidir próximos passos"]
    end

    subgraph plataforma ["Stacklyst"]
        contextualizar["Preparar contexto"]
        validar{"Pedido permitido?"}
        limitar["Aplicar limites"]
        enviar["Solicitar apoio"]
        receber["Receber resposta"]
        apresentar["Apresentar como sugestão"]
        indisponivel["Oferecer conteúdo disponível"]
        bloquear(["Recusar pedido inadequado"])
    end

    subgraph servico ["Serviço de IA"]
        processar["Processar contexto"]
        gerar["Gerar orientação"]
        falhou{"Resposta disponível?"}
    end

    informar --> contextualizar --> validar
    validar -->|"Não"| bloquear
    validar -->|"Sim"| limitar --> enviar --> processar --> gerar --> falhou
    falhou -->|"Não"| indisponivel --> decidir
    falhou -->|"Sim"| receber --> apresentar --> revisar --> decidir

    style usuario fill:#C2E5FF,stroke:#3DADFF
    style plataforma fill:#DCCCFF,stroke:#874FFF
    style servico fill:#FFECBD,stroke:#FFC943
    style bloquear fill:#FFCDC2,stroke:#FF7556
    style apresentar fill:#CDF4D3,stroke:#66D575
