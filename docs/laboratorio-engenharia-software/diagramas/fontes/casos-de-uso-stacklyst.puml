@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome

actor "Usuário / Estudante /\nDesenvolvedor" as Usuario
actor Avaliador
actor Administrador
actor "Empresa / Recrutador" as Empresa
actor "Serviço de IA" as IA

rectangle Stacklyst {
  package "Conta e perfil" {
    usecase "UC001\nCadastrar usuário" as UC001
    usecase "UC002\nRealizar login" as UC002
    usecase "UC003\nGerenciar perfil" as UC003
  }

  package "Aprendizado e gamificação" {
    usecase "UC004\nIniciar trilha" as UC004
    usecase "UC005\nAcessar lição" as UC005
    usecase "UC006\nResolver exercício" as UC006
    usecase "UC007\nConsultar progresso" as UC007
    usecase "UC011\nConsultar ranking" as UC011
    usecase "UC012\nUtilizar assistência da IA" as UC012
  }

  package "Duelos e avaliação" {
    usecase "UC008\nParticipar de duelo" as UC008
    usecase "UC009\nRealizar matchmaking" as UC009
    usecase "UC010\nAvaliar desafio" as UC010
    usecase "UC016\nAvaliar solução como avaliador" as UC016
    usecase "UC024\nSolicitar função de avaliador" as UC024
  }

  package "Comunidade e eventos" {
    usecase "UC013\nCriar publicação" as UC013
    usecase "UC014\nInteragir com publicação" as UC014
    usecase "UC015\nGerenciar evento" as UC015
    usecase "UC023\nParticipar de evento" as UC023
    usecase "UC020\nGerenciar denúncias" as UC020
  }

  package "Vagas e empresas" {
    usecase "UC017\nPublicar vaga" as UC017
    usecase "UC018\nConsultar vagas" as UC018
    usecase "UC022\nCandidatar-se a vaga" as UC022
    usecase "UC025\nCadastrar empresa" as UC025
  }

  package "Administração e comunicação" {
    usecase "UC019\nAdministrar usuários" as UC019
    usecase "UC021\nVisualizar notificações" as UC021
  }
}

